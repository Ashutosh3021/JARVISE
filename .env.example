# JARVIS Environment Configuration

# Groq API (LLM inference)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Voice
WHISPER_MODEL=base
KOKORO_VOICE=bm_lewis
TTS_SPEED=1.0

# Memory
CHROMA_PERSIST_DIRECTORY=./data/chromadb
MEMORY_FILE=./data/MEMORY.md

# Logging
LOG_LEVEL=INFO
LOG_FILE=./data/jarvis.log
